package views

// 1. FILM FORM
templ FilmForm() {
	<form id="form-film">
		<label for="film-title">Título:</label>
		<input type="text" id="film-title" name="filmtitle" maxlength="200" required/>

		<label for="film-release-date">Fecha de estreno:</label>
		<input type="date" id="film-release-date" name="filmreleasedate" required/>

		<label for="film-duration">Duración (min):</label>
		<input type="number" id="film-duration" name="filmduration" min="1" required/>

		<button type="submit">Crear Película</button>
	</form>
}

// 2. GENRE FORM
templ GenreForm() {
	<form id="form-genre">
		<label for="genre-name">Nombre del género:</label>
		<input type="text" id="genre-name" name="genrename" maxlength="30" required/>

		<button type="submit">Crear Género</button>
	</form>
}

// 3. CAST MEMBER FORM
templ CastMemberForm() {
	<form id="form-castmember">
		<label for="castmember-name">Nombre:</label>
		<input type="text" id="castmember-name" name="castmembername" maxlength="100" required/>

		<label for="castmember-role">Rol (1 carácter, ej. A/D):</label>
		<input type="text" id="castmember-role" name="castmemberrole" maxlength="1" required/>

		<label for="castmember-gender">Género (1 carácter, ej. M/F):</label>
		<input type="text" id="castmember-gender" name="castmembergender" maxlength="1" required/>

		<button type="submit">Crear Miembro</button>
	</form>
}

// 4. STATUS FORM
templ StatusForm() {
	<form id="form-status">
		<label for="status-name">Nombre del estado:</label>
		<input type="text" id="status-name" name="statusname" maxlength="20" required/>

		<button type="submit">Crear Estado</button>
	</form>
}

// 5. USER FORM
templ UserForm() {
	<form id="form-user">
		<label for="user-name">Nombre de usuario:</label>
		<input type="text" id="user-name" name="username" maxlength="120" required/>

		<label for="user-password">Contraseña:</label>
		<input type="password" id="user-password" name="userpasswordhashed" maxlength="200" required/>

		<label for="user-birthday">Fecha de nacimiento:</label>
		<input type="date" id="user-birthday" name="userbirthday" required/>

		<label for="user-genre">Género (1 carácter, ej. M/F):</label>
		<input type="text" id="user-genre" name="usergenre" maxlength="1" required/>

		<button type="submit">Crear Usuario</button>
	</form>
}

// 6. REVIEW FORM
templ ReviewForm() {
	<form id="form-review">
		<label for="review-film-id">ID Película:</label>
		<input type="number" id="review-film-id" name="reviewfilmid" min="1" required/>

		<label for="review-user-id">ID Usuario:</label>
		<input type="number" id="review-user-id" name="reviewuserid" min="1" required/>

		<label for="review-stars">Estrellas (1-5):</label>
		<input type="number" id="review-stars" name="reviewstars" min="1" max="5" required/>

		<label for="review-description">Descripción:</label>
		<textarea id="review-description" name="reviewdescription" required></textarea>

		<button type="submit">Crear Reseña</button>
	</form>
}

// 7. FILM CAST FORM
templ FilmCastForm() {
	<form id="form-filmcast">
		<label for="filmcast-film-id">ID Película:</label>
		<input type="number" id="filmcast-film-id" name="filmid" min="1" required/>

		<label for="filmcast-castmember-id">ID Miembro del Elenco:</label>
		<input type="number" id="filmcast-castmember-id" name="castmemberid" min="1" required/>

		<button type="submit">Asociar Elenco a Película</button>
	</form>
}

// 8. FILM GENRE FORM
templ FilmGenreForm() {
	<form id="form-filmgenre">
		<label for="filmgenre-genre-id">ID Género:</label>
		<input type="number" id="filmgenre-genre-id" name="genre_genreid" min="1" required/>

		<label for="filmgenre-film-id">ID Película:</label>
		<input type="number" id="filmgenre-film-id" name="film_filmid" min="1" required/>

		<button type="submit">Asociar Género a Película</button>
	</form>
}

// 9. FILM USER STATUS FORM
templ FilmUserStatusForm() {
	<form id="form-filmuserstatus">
		<label for="fus-film-id">ID Película:</label>
		<input type="number" id="fus-film-id" name="film_filmid" min="1" required/>

		<label for="fus-user-id">ID Usuario:</label>
		<input type="number" id="fus-user-id" name="user_userid" min="1" required/>

		<label for="fus-status-id">ID Estado:</label>
		<input type="number" id="fus-status-id" name="status_statusid" min="1" required/>

		<button type="submit">Asignar Estado</button>
	</form>
}

