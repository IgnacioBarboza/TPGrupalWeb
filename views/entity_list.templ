package views

import (
	dto "WebGrupal/internal"
	"fmt"
)

// 1. FILM LIST
templ FilmList(films []dto.Film) {
	<ul id="list-films">
		if len(films) == 0 {
			<li>No hay películas cargadas.</li>
		} else {
			for _, film := range films {
				<li>
					<span>
						{ fmt.Sprintf("[ID: %d] %s - Estreno: %s - Duración: %d min", film.Filmid, film.Filmtitle, film.Filmreleasedate.Format("2006-01-02"), film.Filmduration) }
					</span>
					<button type="button">Eliminar</button>
				</li>
			}
		}
	</ul>
}

// 2. GENRE LIST
templ GenreList(genres []dto.Genre) {
	<ul id="list-genres">
		if len(genres) == 0 {
