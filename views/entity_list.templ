// 9. FILM USER STATUS LIST
templ FilmUserStatusList(statuses []dto.Filmuserstatus) {
	<ul id="list-filmuserstatuses">
		if len(statuses) == 0 {
			<li>No hay estados de película por usuario cargados.</li>
