// UserItem es la fila de un usuario en modo lectura, con los botones Editar y Borrar.
templ UserItem(u dto.User) {
	<li>
		<span>
			{ fmt.Sprintf("[ID: %d] %s - Nacimiento: %s - Género: %s", u.Userid, u.Username, u.Userbirthday.Format("2006-01-02"), u.Usergenre) }
		</span>
		<button type="button"
			hx-get={ fmt.Sprintf("/users/%d/edit", u.Userid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/users/%d", u.Userid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-confirm={ fmt.Sprintf("¿Borrar al usuario \"%s\"? También se borrarán sus reseñas y los estados que les puso a las películas.", u.Username) }>
			Borrar
		</button>
	</li>
}

// UserEditItem es la misma fila convertida en formulario: Guardar hace PUT y Cancelar vuelve a UserItem.
templ UserEditItem(u dto.User) {
	<li>
		<form
			hx-put={ fmt.Sprintf("/users/%d", u.Userid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-status:4xx={ fmt.Sprintf("target:#error-user-%d swap:innerHTML", u.Userid) }
			hx-status:5xx={ fmt.Sprintf("target:#error-user-%d swap:innerHTML", u.Userid) }>
			<input type="text" name="username" value={ u.Username } aria-label="Nombre" maxlength="120" required/>
			<input type="password" name="userpasswordhashed" aria-label="Nueva contraseña" placeholder="Nueva contraseña (vacío = no cambiar)" maxlength="200"/>
			<input type="date" name="userbirthday" value={ u.Userbirthday.Format("2006-01-02") } aria-label="Fecha de nacimiento" required/>
			<input type="text" name="usergenre" value={ u.Usergenre } aria-label="Género" maxlength="1" required/>
			<button type="submit">Guardar</button>
			<button type="button"
				hx-get={ fmt.Sprintf("/users/%d", u.Userid) }
				hx-target="closest li"
				hx-swap="outerHTML">
				Cancelar
			</button>
			<p id={ fmt.Sprintf("error-user-%d", u.Userid) }></p>
		</form>
	</li>
}

// ReviewItem es la fila de una reseña en modo lectura, con los botones Editar y Borrar.
templ ReviewItem(rev dto.Review) {
	<li>
		<span>
			{ fmt.Sprintf("[Película ID: %d | Usuario ID: %d] %d★ - %q", rev.Reviewfilmid, rev.Reviewuserid, rev.Reviewstars, rev.Reviewdescription) }
		</span>
		<button type="button"
			hx-get={ fmt.Sprintf("/reviews/%d/%d/edit", rev.Reviewfilmid, rev.Reviewuserid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/reviews/%d/%d", rev.Reviewfilmid, rev.Reviewuserid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Borrar
		</button>
	</li>
}

// ReviewEditItem es la misma fila convertida en formulario: Guardar hace PUT y Cancelar vuelve a ReviewItem.
templ ReviewEditItem(rev dto.Review) {
	<li>
		<form
			hx-put={ fmt.Sprintf("/reviews/%d/%d", rev.Reviewfilmid, rev.Reviewuserid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-status:4xx={ fmt.Sprintf("target:#error-review-%d-%d swap:innerHTML", rev.Reviewfilmid, rev.Reviewuserid) }
			hx-status:5xx={ fmt.Sprintf("target:#error-review-%d-%d swap:innerHTML", rev.Reviewfilmid, rev.Reviewuserid) }>
			<input type="number" name="reviewstars" value={ fmt.Sprint(rev.Reviewstars) } aria-label="Estrellas" min="1" max="5" required/>
			<textarea name="reviewdescription" aria-label="Descripción" required>{ rev.Reviewdescription }</textarea>
			<button type="submit">Guardar</button>
			<button type="button"
				hx-get={ fmt.Sprintf("/reviews/%d/%d", rev.Reviewfilmid, rev.Reviewuserid) }
				hx-target="closest li"
				hx-swap="outerHTML">
				Cancelar
			</button>
			<p id={ fmt.Sprintf("error-review-%d-%d", rev.Reviewfilmid, rev.Reviewuserid) }></p>
		</form>
	</li>
}

