package views

import (
	dto "WebGrupal/internal"
	"fmt"
)

// 1. FILM LIST
templ FilmList(films []dto.Film) {
	<div id="list-films">
		<ul>
			if len(films) == 0 {
				<li>No hay películas cargadas.</li>
			} else {
				for _, film := range films {
					@FilmItem(film)
				}
			}
		</ul>
	</div>
}

// 2. GENRE LIST
templ GenreList(genres []dto.Genre) {
	<div id="list-genres">
		<ul>
			if len(genres) == 0 {
				<li>No hay géneros cargados.</li>
			} else {
				for _, genre := range genres {
					@GenreItem(genre)
				}
			}
		</ul>
	</div>
}

// 3. CAST MEMBER LIST
templ CastMemberList(castMembers []dto.Castmember) {
	<div id="list-castmembers">
		<ul>
			if len(castMembers) == 0 {
				<li>No hay miembros del elenco cargados.</li>
			} else {
				for _, cm := range castMembers {
					@CastMemberItem(cm)
				}
			}
		</ul>
	</div>
}

// 4. STATUS LIST
templ StatusList(statuses []dto.Status) {
	<div id="list-statuses">
		<ul>
			if len(statuses) == 0 {
				<li>No hay estados cargados.</li>
			} else {
				for _, st := range statuses {
					@StatusItem(st)
				}
			}
		</ul>
	</div>
}

// 5. USER LIST
templ UserList(users []dto.User) {
	<div id="list-users">
		<ul>
			if len(users) == 0 {
				<li>No hay usuarios cargados.</li>
			} else {
				for _, u := range users {
					@UserItem(u)
				}
			}
		</ul>
	</div>
}

// 6. REVIEW LIST
templ ReviewList(reviews []dto.Review) {
	<div id="list-reviews"
		hx-get="/reviews"
		hx-trigger="filmDeleted from:body, userDeleted from:body"
		hx-swap="outerHTML">
		<ul>
			if len(reviews) == 0 {
				<li>No hay reseñas cargadas.</li>
			} else {
				for _, rev := range reviews {
					@ReviewItem(rev)
				}
			}
		</ul>
	</div>
}

// 7. FILM CAST LIST
templ FilmCastList(filmCasts []dto.Filmcast) {
	<div id="list-filmcasts"
		hx-get="/filmcasts"
		hx-trigger="filmDeleted from:body, castMemberDeleted from:body"
		hx-swap="outerHTML">
		<ul>
			if len(filmCasts) == 0 {
				<li>No hay relaciones FilmCast cargadas.</li>
			} else {
				for _, fc := range filmCasts {
					@FilmCastItem(fc)
				}
			}
		</ul>
	</div>
}

// 8. FILM GENRE LIST
templ FilmGenreList(filmGenres []dto.Filmgenre) {
	<div id="list-filmgenres"
		hx-get="/filmgenres"
		hx-trigger="filmDeleted from:body, genreDeleted from:body"
		hx-swap="outerHTML">
		<ul>
			if len(filmGenres) == 0 {
				<li>No hay relaciones FilmGenre cargadas.</li>
			} else {
				for _, fg := range filmGenres {
					@FilmGenreItem(fg)
				}
			}
		</ul>
	</div>
}

// 9. FILM USER STATUS LIST
templ FilmUserStatusList(statuses []dto.Filmuserstatus) {
	<div id="list-filmuserstatuses"
		hx-get="/filmuserstatuses"
		hx-trigger="filmDeleted from:body, userDeleted from:body, statusDeleted from:body"
		hx-swap="outerHTML">
		<ul>
			if len(statuses) == 0 {
				<li>No hay estados de película por usuario cargados.</li>
			} else {
				for _, fus := range statuses {
					@FilmUserStatusItem(fus)
				}
			}
		</ul>
	</div>
}

// FilmItem es la fila de una película en modo lectura, con los botones Editar y Borrar.
templ FilmItem(film dto.Film) {
	<li>
		<span>
			{ fmt.Sprintf("[ID: %d] %s - Estreno: %s - Duración: %d min", film.Filmid, film.Filmtitle, film.Filmreleasedate.Format("2006-01-02"), film.Filmduration) }
		</span>
		<button type="button"
			hx-get={ fmt.Sprintf("/films/%d/edit", film.Filmid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/films/%d", film.Filmid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-confirm={ fmt.Sprintf("¿Borrar la película \"%s\"? También se borrarán sus reseñas, sus géneros asignados, su elenco y los estados que le pusieron los usuarios.", film.Filmtitle) }>
			Borrar
		</button>
	</li>
}

// FilmEditItem es la misma fila convertida en formulario: Guardar hace PUT y Cancelar vuelve a FilmItem.
templ FilmEditItem(film dto.Film) {
	<li>
		<form
			hx-put={ fmt.Sprintf("/films/%d", film.Filmid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-status:4xx={ fmt.Sprintf("target:#error-film-%d swap:innerHTML", film.Filmid) }
			hx-status:5xx={ fmt.Sprintf("target:#error-film-%d swap:innerHTML", film.Filmid) }>
			<input type="text" name="filmtitle" value={ film.Filmtitle } aria-label="Título" maxlength="200" required/>
			<input type="date" name="filmreleasedate" value={ film.Filmreleasedate.Format("2006-01-02") } aria-label="Fecha de estreno" required/>
			<input type="number" name="filmduration" value={ fmt.Sprint(film.Filmduration) } aria-label="Duración (min)" min="1" required/>
			<button type="submit">Guardar</button>
			<button type="button"
				hx-get={ fmt.Sprintf("/films/%d", film.Filmid) }
				hx-target="closest li"
				hx-swap="outerHTML">
				Cancelar
			</button>
			<p id={ fmt.Sprintf("error-film-%d", film.Filmid) }></p>
		</form>
	</li>
}

// GenreItem es la fila de un género en modo lectura, con los botones Editar y Borrar.
templ GenreItem(genre dto.Genre) {
	<li>
		<span>
			{ fmt.Sprintf("[ID: %d] %s", genre.Genreid, genre.Genrename) }
		</span>
		<button type="button"
			hx-get={ fmt.Sprintf("/genres/%d/edit", genre.Genreid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/genres/%d", genre.Genreid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-confirm={ fmt.Sprintf("¿Borrar el género \"%s\"? También se quitará de todas las películas que lo tienen (las películas no se borran).", genre.Genrename) }>
			Borrar
		</button>
	</li>
}

// GenreEditItem es la misma fila convertida en formulario: Guardar hace PUT y Cancelar vuelve a GenreItem.
templ GenreEditItem(genre dto.Genre) {
	<li>
		<form
			hx-put={ fmt.Sprintf("/genres/%d", genre.Genreid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-status:4xx={ fmt.Sprintf("target:#error-genre-%d swap:innerHTML", genre.Genreid) }
			hx-status:5xx={ fmt.Sprintf("target:#error-genre-%d swap:innerHTML", genre.Genreid) }>
			<input type="text" name="genrename" value={ genre.Genrename } aria-label="Nombre del género" maxlength="30" required/>
			<button type="submit">Guardar</button>
			<button type="button"
				hx-get={ fmt.Sprintf("/genres/%d", genre.Genreid) }
				hx-target="closest li"
				hx-swap="outerHTML">
				Cancelar
			</button>
			<p id={ fmt.Sprintf("error-genre-%d", genre.Genreid) }></p>
		</form>
	</li>
}

// CastMemberItem es la fila de un miembro del elenco en modo lectura, con los botones Editar y Borrar.
templ CastMemberItem(cm dto.Castmember) {
	<li>
		<span>
			{ fmt.Sprintf("[ID: %d] %s - Rol: %s - Género: %s", cm.Castmemberid, cm.Castmembername, cm.Castmemberrole, cm.Castmembergender) }
		</span>
		<button type="button"
			hx-get={ fmt.Sprintf("/castmembers/%d/edit", cm.Castmemberid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/castmembers/%d", cm.Castmemberid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-confirm={ fmt.Sprintf("¿Borrar a \"%s\"? También se quitará del elenco de todas sus películas (las películas no se borran).", cm.Castmembername) }>
			Borrar
		</button>
	</li>
}

