// StatusItem es la fila de un estado en modo lectura, con los botones Editar y Borrar.
templ StatusItem(st dto.Status) {
	<li>
		<span>
			{ fmt.Sprintf("[ID: %d] %s", st.Statusid, st.Statusname) }
