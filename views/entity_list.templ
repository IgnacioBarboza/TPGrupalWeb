		<button type="button"
			hx-get={ fmt.Sprintf("/statuses/%d/edit", st.Statusid) }
			hx-target="closest li"
			hx-swap="outerHTML">
			Editar
		</button>
		<button type="button"
			hx-delete={ fmt.Sprintf("/statuses/%d", st.Statusid) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-confirm={ fmt.Sprintf("¿Borrar el estado \"%s\"? También se borrarán los estados de película por usuario que lo usan.", st.Statusname) }>
			Borrar
		</button>
	</li>
}

// StatusEditItem es la misma fila convertida en formulario: Guardar hace PUT y Cancelar vuelve a StatusItem.
